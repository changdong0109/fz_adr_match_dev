}

QPushButton#step3_result_ok_btn {
    background-color: #1890ff;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 24px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#step3_result_ok_btn:hover {
    background-color: #40a9ff;
}

QPushButton#step3_result_ok_btn:pressed {
    background-color: #096dd9;
}

/* ========== 通用结果弹窗样式 ========== */

QDialog#common_result_dialog {
    background-color: white;
}

QLabel#result_dialog_icon {
    font-size: 36px;
}

/* 标题样式 - 按类型区分 */
QLabel#result_dialog_title_success {
    font-size: 18px;
    font-weight: bold;
    color: #15803d;
}

QLabel#result_dialog_title_error {
    font-size: 18px;
    font-weight: bold;
    color: #dc2626;
}

QLabel#result_dialog_title_warning {
    font-size: 18px;
    font-weight: bold;
    color: #d97706;
}

QLabel#result_dialog_title_info {
    font-size: 18px;
    font-weight: bold;
    color: #2563eb;
}

QLabel#result_dialog_message {
    font-size: 13px;
    color: #4b5563;
