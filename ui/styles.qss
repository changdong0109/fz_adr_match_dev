}

/* ========== GlobalConfigWidget 全局配置组件样式 ========== */

QPushButton#global_config_btn_choose {
    font-size: 12px;
    padding: 4px 8px;
    background-color: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
}

QPushButton#global_config_btn_choose:hover {
    background-color: #e2e8f0;
}

QLineEdit#global_config_path_display {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #334155;
    padding: 4px 8px;
    border-radius: 4px;
}

QPushButton#global_config_btn_confirm {
    font-size: 13px;
    padding: 6px 12px;
    background-color: #0284c7;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
}

QPushButton#global_config_btn_confirm:hover {
    background-color: #0369a1;
}

QPushButton#global_config_btn_confirm:disabled {
    background-color: #cbd5e1;
    color: #94a3b8;
}

/* ========== Step3 提示标签样式 ========== */

QLabel#step3_tip_label {
    color: #64748b;
    font-size: 12px;
}

/* ========== ClearDialog 清除缓存对话框样式 ========== */

QLabel#clear_dialog_icon {
    font-size: 32px;
}

QLabel#clear_dialog_title {
    font-size: 16px;
    font-weight: bold;
    color: #1e293b;
}

QFrame#clear_dialog_separator {
    background-color: #e2e8f0;
}

QCheckBox#clear_dialog_checkbox {
    font-size: 14px;
    color: #334155;
    spacing: 8px;
}

QCheckBox#clear_dialog_checkbox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #cbd5e1;
    border-radius: 3px;
    background-color: white;
}

QCheckBox#clear_dialog_checkbox::indicator:checked {
    background-color: #0284c7;
    border-color: #0284c7;
}

QLabel#clear_dialog_tip {
    color: #64748b;
    font-size: 12px;
    padding-left: 24px;
}

QLabel#clear_dialog_warning {
    color: #dc2626;
    font-size: 12px;
    padding: 8px;
    background-color: #fef2f2;
    border-radius: 4px;
}

QPushButton#clear_dialog_btn_confirm {
    background-color: #dc2626;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#clear_dialog_btn_confirm:hover {
    background-color: #b91c1c;
}

