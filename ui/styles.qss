/* ========== Step5 导出 & 日志样式 ========== */

QLabel#step5_tip {
    font-size: 12px;
    color: #6b7280;
    padding: 8px 12px;
    background-color: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 4px;
}

/* 统计卡片 */
QWidget#step5_stat_card {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    min-width: 140px;
}

QWidget#step5_stat_card:hover {
    border-color: #3b82f6;
    background-color: #f8fafc;
}

QLabel#step5_stat_icon {
    font-size: 20px;
}

QLabel#step5_stat_title {
    font-size: 12px;
    color: #6b7280;
}

QLabel#step5_stat_value {
    font-size: 24px;
    font-weight: 700;
    color: #1e3a5f;
}

QLabel#step5_stat_unit {
    font-size: 12px;
    color: #9ca3af;
    padding-top: 8px;
}

/* 复选框 */
QCheckBox#step5_checkbox {
    font-size: 13px;
    color: #374151;
    spacing: 8px;
    padding: 4px 0;
}

QCheckBox#step5_checkbox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #d1d5db;
    border-radius: 3px;
    background-color: white;
}

QCheckBox#step5_checkbox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

QCheckBox#step5_checkbox::indicator:hover {
    border-color: #3b82f6;
}

/* 路径输入框 */
QLineEdit#step5_path_input {
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 12px;
    background-color: white;
}

QLineEdit#step5_path_input:focus {
    border-color: #3b82f6;
}

/* 进度条 */
QProgressBar#step5_progress {
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    text-align: center;
    height: 20px;
    background-color: #f3f4f6;
    font-size: 11px;
}

QProgressBar#step5_progress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6, stop:1 #60a5fa);
    border-radius: 3px;
}

QLabel#step5_status_label {
    font-size: 12px;
    color: #6b7280;
    padding: 0 8px;
}

/* 按钮 */
QPushButton#step5_btn_refresh {
    padding: 6px 14px;
    font-size: 12px;
    background-color: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}

QPushButton#step5_btn_refresh:hover {
    background-color: #e5e7eb;
}

QPushButton#step5_btn_browse {
    padding: 6px 14px;
    font-size: 12px;
    background-color: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}

QPushButton#step5_btn_browse:hover {
    background-color: #e5e7eb;
}

QPushButton#step5_btn_export {
    padding: 8px 20px;
    font-size: 13px;
    background-color: #10b981;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton#step5_btn_export:hover {
    background-color: #059669;
}

QPushButton#step5_btn_secondary {
    padding: 8px 16px;
    font-size: 13px;
    background-color: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}

QPushButton#step5_btn_secondary:hover {
    background-color: #e5e7eb;
}

/* 历史表格 */
QTableWidget#step5_history_table {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
    gridline-color: #e5e7eb;
    font-size: 12px;
}

QTableWidget#step5_history_table::item {
    padding: 6px 8px;
}

