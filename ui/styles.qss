}

QPushButton#result_dialog_ok_btn {
    background-color: #1890ff;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 28px;
    font-size: 14px;
    font-weight: 500;
    min-width: 80px;
}

QPushButton#result_dialog_ok_btn:hover {
    background-color: #40a9ff;
}

QPushButton#result_dialog_ok_btn:pressed {
    background-color: #096dd9;
}

/* ========== Step4 匹配任务管理样式 - 左右分栏布局 ========== */

/* 左侧面板 */
QFrame#step4_left_panel {
    background-color: #f8fafc;
    border-right: 1px solid #e2e8f0;
}

QLabel#step4_panel_title {
    font-size: 14px;
    font-weight: 600;
    color: #1e293b;
    padding: 4px 0;
}

QListWidget#step4_task_list {
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    background-color: #ffffff;
    font-size: 12px;
    outline: none;
}

QListWidget#step4_task_list::item {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
}

QListWidget#step4_task_list::item:selected {
    background-color: #0284c7;
    border-left: 3px solid #0369a1;
    color: #ffffff;
}

QListWidget#step4_task_list::item:hover:!selected {
    background-color: #f1f5f9;
}

QFrame#step4_separator {
    color: #e2e8f0;
    margin: 8px 0;
}

QLabel#step4_batch_label {
    font-size: 11px;
    color: #64748b;
    padding: 4px 0;
}

QPushButton#step4_btn_batch_run {
    padding: 6px 12px;
    font-size: 12px;
    background-color: #0284c7;
    color: white;
    border: none;
    border-radius: 4px;
}

QPushButton#step4_btn_batch_run:hover {
    background-color: #0369a1;
}

QPushButton#step4_btn_batch_stop {
    padding: 6px 12px;
    font-size: 12px;
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
}

QPushButton#step4_btn_batch_stop:hover {
    background-color: #e2e8f0;
}

/* 右侧面板 */
QFrame#step4_right_panel {
