/* ============================================================
   QSS Stylesheet for fz_adr_match plugin
   地址匹配插件的主样式表 - QGIS风格配色
   ============================================================ */

/* QGIS风格配色变量（通过注释说明，实际QSS不支持变量） */
/* 主背景: #ffffff, 侧边栏: #f0f0f0, 边框: #d0d0d0, 主题色: #0078d4, 文字: #000000 */

/* ========== 主对话框样式 ========== */
/* 侧边栏样式 - QGIS原生风格 */
QWidget#sidebar {
    background-color: palette(window);
    border-right: 1px solid palette(mid);
}

QLabel#sidebar_header {
    padding: 12px 10px;
    border-bottom: 1px solid palette(mid);
    font-size: 12px;
    font-weight: 600;
    color: palette(windowText);
    background-color: palette(button);
}

QListWidget#step_list {
    border: none;
    background-color: transparent;
    outline: none;
    color: palette(windowText);
    font-size: 12px;
    padding: 4px 0px;
}

QListWidget#step_list::item {
    padding: 10px 12px;
    border: none;
    border-left: 3px solid transparent;
    color: palette(windowText);
}

QListWidget#step_list::item:hover {
    background-color: palette(midlight);
    border-left: 3px solid palette(highlight);
}

QListWidget#step_list::item:selected {
    background-color: palette(highlight);
    color: palette(highlightedText);
    border-left: 3px solid palette(highlight);
}

QListWidget#step_list::item:selected:hover {
    background-color: palette(highlight);
    color: palette(highlightedText);
    border-left: 3px solid palette(highlight);
}

QLabel#sidebar_footer {
    padding: 8px 10px;
    border-top: 1px solid palette(mid);
    font-size: 10px;
    color: palette(disabled, windowText);
    background-color: palette(button);
}

/* 主内容区样式 */
QWidget#main_content {
    background-color: #ffffff;
}

QWidget#header_widget {
    background-color: #ffffff;
    border-bottom: 1px solid #d0d0d0;
    padding: 10px 16px;
}

QLabel#header_title {
    font-size: 15px;
    font-weight: 600;
    color: #000000;
}

QLabel#header_subtitle {
    font-size: 13px;
    color: #666666;
}

QScrollArea#content_scroll {
    border: none;
    background-color: #ffffff;
}

/* ========== GroupBox样式 ========== */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    font-size: 14px;
    color: #000000;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #000000;
}

/* Collapsible GroupBox with arrow indicators */
QGroupBox::indicator {
    width: 18px;
    height: 18px;
    margin-left: 4px;
}

/* Down arrow when section is expanded (checked) */
QGroupBox::indicator:checked {
    background-image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNNyAxMEwxMSAxNEwxNyA4IiBzdHJva2U9IiMwMDAwMDAiIHN0cm9rZS13aWR0aD0iMiIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIi8+PC9zdmc+);
    background-repeat: no-repeat;
    background-position: center;
}

/* Right arrow when section is collapsed (unchecked) */
QGroupBox::indicator:unchecked {
    background-image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNOCA1TDEzIDEwTDggMTUiIHN0cm9rZT0iIzAwMDAwMCIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
    background-repeat: no-repeat;
    background-position: center;
}

/* Hover effect for better UX */
QGroupBox::indicator:hover {
    background-color: #f0f0f0;
    border-radius: 3px;
}

/* ========== 表格样式 ========== */
QTableWidget {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
    gridline-color: #d0d0d0;
    font-size: 13px;
}

QTableWidget::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #d0e8ff;
    color: #000000;
}

QTableWidget::item:hover {
    background-color: #f0f0f0;
}

/* 表格中的下拉框样式 */
QTableWidget QComboBox {
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    padding: 4px 8px;
    background-color: #ffffff;
    min-width: 140px;
}

QTableWidget QComboBox::drop-down {
    border: none;
    width: 20px;
}

QTableWidget QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* Step1 表格样式 */
QTableWidget#step1_data_sources_table::item {
    padding: 4px 8px;
}

QTableWidget#step1_data_sources_table QCheckBox {
    margin-left: 12px;
    padding: 2px;
}

/* Step1 状态标签样式 */
QLabel#step1_shp_status_label {
    color: #666666;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #f0f0f0;
    border: 1px solid #d0d0d0;
    padding: 8px;
    font-weight: 600;
    font-size: 13px;
    color: #000000;
}

/* ========== 输入框样式 ========== */
QLineEdit {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 13px;
    background-color: #ffffff;
    color: #000000;
}

QLineEdit:focus {
    border-color: #0078d4;
    outline: none;
}

QComboBox {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 13px;
    background-color: #ffffff;
    color: #000000;
}

QComboBox:focus {
    border-color: #0078d4;
}

/* ========== 按钮样式 ========== */
QPushButton {
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #d0d0d0;
    background-color: #f0f0f0;
    color: #000000;
}

QPushButton:hover {
    background-color: #e0e0e0;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

QPushButton:disabled {
    background-color: #c0c0c0;
    color: #666666;
}

/* 主按钮样式 */
QPushButton[class="primary"] {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

QPushButton[class="primary"]:hover {
    background-color: #005a9e;
}

QPushButton[class="primary"]:pressed {
    background-color: #004578;
}

/* ========== Step1 按钮样式 ========== */
QPushButton#step1_btn_add,
QPushButton#step1_btn_del,
QPushButton#step1_btn_refresh,
QPushButton#step1_btn_browse {
    font-size: 12px;
    padding: 6px 12px;
    min-width: 80px;
}

QPushButton#step1_btn_run {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
    font-size: 13px;
    padding: 6px 16px;
    min-width: 80px;
}

QPushButton#step1_btn_run:hover {
    background-color: #005a9e;
}

QPushButton#step1_btn_pause,
QPushButton#step1_btn_stop {
    font-size: 13px;
    padding: 6px 16px;
    min-width: 80px;
}

/* ========== 进度条样式 ========== */
QProgressBar {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #f0f0f0;
    text-align: center;
    font-size: 12px;
    color: #000000;
    height: 24px;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* ========== 日志面板样式 ========== */
QGroupBox#log_panel_group {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 18px;
    font-weight: 600;
    font-size: 14px;
    color: #000000;
    background-color: #ffffff;
}

QGroupBox#log_panel_group::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #000000;
    font-weight: 600;
    font-size: 14px;
}

QTextEdit#log_panel {
    background-color: #ffffff;
    color: #000000;
    font-size: 12px;
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 8px 10px;
}

/* ========== Step2 样式 ========== */
/* Step2 文件列表表格 */
QTableWidget#step2_cfg_progress_table {
    font-size: 13px;
}

/* Step2 字段组合滚动区域 */
QScrollArea#step2_field_combos_scroll {
    border: 1px dashed #d1d5db;
    border-radius: 4px;
    background: #f9fafb;
}

/* Step2 标签样式 */
QLabel#step2_tip_label {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 2px;
    margin-bottom: 2px;
}

QLabel#step2_current_file_label {
    font-size: 12px;
    color: #6b7280;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* Step2 字段组合框架 */
QFrame#step2_combo_frame {
    border: 1px dashed #d1d5db;
    border-radius: 4px;
    padding: 8px;
    background: #f9fafb;
    margin-bottom: 8px;
}

/* Step2 组合标题标签 */
QLabel#step2_combo_title_label {
    font-size: 12px;
    font-weight: 500;
}

/* Step2 字段表格 */
QTableWidget#step2_field_table {
    font-size: 12px;
}

/* Step2 按钮样式 */
QPushButton#step2_btn_refresh {
    font-size: 13px;
    padding: 6px 12px;
}

QPushButton#step2_btn_add_combo {
    padding: 6px 16px;
    font-size: 13px;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 500;
    min-width: 120px;
}

QPushButton#step2_btn_add_combo:hover {
    background-color: #1d4ed8;
}

QPushButton#step2_btn_delete_combo {
    padding: 3px 7px;
    font-size: 11px;
    background-color: #ef4444;
    color: white;
    border: none;
    border-radius: 3px;
}

QPushButton#step2_btn_delete_combo:hover {
    background-color: #dc2626;
}

QPushButton#step2_btn_add_field {
    font-size: 13px;
    padding: 6px 16px;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 500;
    min-width: 120px;
}

QPushButton#step2_btn_add_field:hover {
    background-color: #1d4ed8;
}

QPushButton#step2_btn_field_up,
QPushButton#step2_btn_field_down {
    font-size: 12px;
    padding: 4px 10px;
    min-width: 50px;
    border: 1px solid #d0d0d0;
    background-color: #f0f0f0;
    color: #000000;
    border-radius: 3px;
}

QPushButton#step2_btn_field_up:hover,
QPushButton#step2_btn_field_down:hover {
    background-color: #e0e0e0;
}

QPushButton#step2_btn_field_delete {
    font-size: 12px;
    padding: 4px 10px;
    min-width: 50px;
    background-color: #ef4444;
    color: white;
    border: none;
    border-radius: 3px;
}

QPushButton#step2_btn_field_delete:hover {
    background-color: #dc2626;
}

QPushButton#step2_btn_save_combo {
    padding: 6px 16px;
    font-size: 13px;
    background-color: #15803d;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 500;
    min-width: 120px;
}

QPushButton#step2_btn_save_combo:hover {
    background-color: #166534;
}

/* Step2 文件选择下拉框 */
QComboBox#step2_file_select_combo {
    font-size: 13px;
    padding: 6px 12px;
    min-width: 300px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
}

QComboBox#step2_file_select_combo:focus {
    border-color: #0078d4;
}

/* Step2 文件配置滚动区域 */
QScrollArea#step2_field_config_scroll {
    border: 1px dashed #d1d5db;
    border-radius: 4px;
    background: #f9fafb;
}

/* Step2 清洗任务提示标签 */
QLabel#step2_clean_tip_label {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 4px;
}

/* Step2 清洗文件列表 */
QListWidget#step2_clean_file_list {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
    font-size: 13px;
    padding: 4px;
}

QListWidget#step2_clean_file_list::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f0f0f0;
}

QListWidget#step2_clean_file_list::item:hover {
    background-color: #f0f0f0;
}

QListWidget#step2_clean_file_list::item:selected {
    background-color: #d0e8ff;
    color: #000000;
}

/* Step2 清洗任务按钮 */
QPushButton#step2_btn_select_all,
QPushButton#step2_btn_deselect_all,
QPushButton#step2_btn_refresh_list {
    font-size: 12px;
    padding: 6px 12px;
    min-width: 80px;
}

QPushButton#step2_btn_run_clean {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
    font-size: 13px;
    padding: 6px 16px;
    min-width: 100px;
    font-weight: 500;
}

QPushButton#step2_btn_run_clean:hover {
    background-color: #005a9e;
}

QPushButton#step2_btn_pause_clean,
QPushButton#step2_btn_stop_clean {
    font-size: 13px;
    padding: 6px 16px;
    min-width: 80px;
}

/* Step2 清洗状态标签 */
QLabel#step2_clean_status_label {
    font-size: 12px;
    color: #6b7280;
    min-width: 80px;
}

/* ========== CollapsibleSection 样式 ========== */
/* 可折叠区域的样式 - 符合文档要求：所有样式在 QSS 中统一管理 */
QFrame#collapsible_section_frame {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background: #ffffff;
}

QLabel#collapsible_section_title {
    font-weight: 600;
    color: #000000;
    font-size: 14px;
}

QToolButton#collapsible_section_toggle_btn {
    border: none;
    background: transparent;
}

QToolButton#collapsible_section_toggle_btn:hover {
    background-color: #f0f0f0;
    border-radius: 3px;
}

/* ========== Step2 清洗结果对话框样式 ========== */
QDialog#step2_clean_result_dialog {
    background-color: #ffffff;
}

QLabel#step2_result_icon {
    font-size: 28px;
}

QLabel#step2_result_title_success {
    font-size: 18px;
    font-weight: bold;
    color: #52c41a;
}

QLabel#step2_result_title_warning {
    font-size: 18px;
    font-weight: bold;
    color: #faad14;
}

QLabel#step2_result_title_error {
    font-size: 18px;
    font-weight: bold;
    color: #ff4d4f;
}

QFrame#step2_result_divider {
    background-color: #e8e8e8;
}

QLabel#step2_result_stats {
    font-size: 14px;
    color: #333333;
}

QFrame#step2_result_tip_frame {
    background-color: #fff7e6;
    border: 1px solid #ffd591;
    border-radius: 6px;
}

QLabel#step2_result_tip_title {
    font-weight: bold;
    color: #d46b08;
    font-size: 13px;
}

QLabel#step2_result_tip_text {
    color: #873800;
    font-size: 12px;
}

QPushButton#step2_result_ok_btn {
    background-color: #1890ff;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 24px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#step2_result_ok_btn:hover {
    background-color: #40a9ff;
}

QPushButton#step2_result_ok_btn:pressed {
    background-color: #096dd9;
}

/* ========== Step3 标准化解析样式 ========== */

/* Step3 进度条 */
QProgressBar#step3_parse_progress {
    border: 1px solid #d1d5db;
    border-radius: 3px;
    text-align: center;
    height: 18px;
    background-color: #f3f4f6;
}

QProgressBar#step3_parse_progress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #1d4ed8);
    border-radius: 2px;
}

/* Step3 刷新按钮 */
QPushButton#step3_btn_refresh {
    padding: 6px 16px;
    font-size: 13px;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
}

QPushButton#step3_btn_refresh:hover {
    background-color: #1d4ed8;
}

QPushButton#step3_btn_refresh:pressed {
    background-color: #1e40af;
}

/* Step3 关联图占位框 */
QTextEdit#step3_graph_placeholder {
    border: 1px dashed #d1d5db;
    border-radius: 4px;
    background: #f9fafb;
    font-size: 12px;
    color: #9ca3af;
}

/* Step3 Key 输入框 */
QLineEdit#step3_key_input {
    padding: 6px 10px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 13px;
}

QLineEdit#step3_key_input:focus {
    border-color: #2563eb;
}

/* Step3 解析表格 */
QTableWidget#step3_parse_table {
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    gridline-color: #f3f4f6;
}

QTableWidget#step3_parse_table::item {
    padding: 4px 8px;
}

/* Step3 状态标签 */
QLabel#step3_status_parsed {
    color: #15803d;
    font-weight: 500;
}

QLabel#step3_status_unparsed {
    color: #6b7280;
}

QLabel#step3_status_error {
    color: #dc2626;
}

/* Step3 测试连接按钮 */
QPushButton#step3_btn_test {
    padding: 6px 12px;
    background-color: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}

QPushButton#step3_btn_test:hover {
    background-color: #e5e7eb;
}

/* Step3 保存按钮 */
QPushButton#step3_btn_save {
    padding: 6px 12px;
    background-color: #10b981;
    color: white;
    border: none;
    border-radius: 4px;
}

QPushButton#step3_btn_save:hover {
    background-color: #059669;
}

/* Step3 清除数据按钮 */
QPushButton#step3_btn_clear {
    padding: 6px 16px;
    font-size: 13px;
    background-color: #fee2e2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 4px;
}

QPushButton#step3_btn_clear:hover {
    background-color: #fecaca;
    border-color: #f87171;
}

QPushButton#step3_btn_clear:pressed {
    background-color: #fca5a5;
}

/* Step3 开始解析按钮 */
QPushButton#step3_btn_run {
    padding: 6px 20px;
    font-size: 13px;
    font-weight: bold;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
}

QPushButton#step3_btn_run:hover {
    background-color: #1d4ed8;
}

QPushButton#step3_btn_run:pressed {
    background-color: #1e40af;
}

/* Step3 智能关联关系 */
QLabel#step3_relation_tip {
    color: #6b7280;
    font-size: 12px;
}

QLabel#step3_relation_label {
    font-weight: 600;
    font-size: 12px;
    color: #374151;
    margin-bottom: 4px;
}

QPushButton#step3_btn_refresh_relation {
    padding: 6px 14px;
    font-size: 12px;
    background-color: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
    border-radius: 4px;
}

QPushButton#step3_btn_refresh_relation:hover {
    background-color: #bae6fd;
    border-color: #7dd3fc;
}

QPushButton#step3_btn_refresh_relation:pressed {
    background-color: #7dd3fc;
}

QSplitter#step3_relation_splitter::handle {
    background-color: #e5e7eb;
    width: 2px;
}

QFrame#step3_graph_placeholder {
    background-color: #f9fafb;
    border: 1px dashed #d1d5db;
    border-radius: 4px;
}

QLabel#step3_graph_hint {
    color: #9ca3af;
    font-size: 12px;
}

QTableWidget#step3_field_list_table,
QTableWidget#step3_relation_pairs_table {
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    gridline-color: #e5e7eb;
    font-size: 12px;
}

QTableWidget#step3_field_list_table::item,
QTableWidget#step3_relation_pairs_table::item {
    padding: 4px 6px;
}

QTableWidget#step3_field_list_table QHeaderView::section,
QTableWidget#step3_relation_pairs_table QHeaderView::section {
    background-color: #f3f4f6;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 500;
    font-size: 12px;
}

QGraphicsView#step3_relation_graph {
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
}

QLabel#step3_relation_status {
    color: #6b7280;
    font-size: 12px;
    margin-left: 12px;
}

QPushButton#step3_btn_page {
    padding: 4px 12px;
    font-size: 12px;
    min-width: 60px;
}

QLabel#step3_page_info {
    color: #6b7280;
    font-size: 12px;
    margin: 0 8px;
}

QComboBox#step3_file_pair_filter {
    padding: 4px 8px;
    font-size: 12px;
    min-width: 180px;
}

/* 关联详情弹窗样式 */
QDialog#relation_detail_dialog {
    background-color: #ffffff;
}

QLabel#relation_detail_title {
    font-size: 16px;
    font-weight: bold;
    color: #1f2937;
    padding: 4px 0;
}

QFrame#relation_detail_line {
    background-color: #e5e7eb;
    max-height: 1px;
}

QFrame#relation_detail_card {
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 12px;
}

QTextEdit#relation_detail_values {
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 8px;
    font-family: Consolas, monospace;
    font-size: 12px;
}

QPushButton#relation_detail_btn_export {
    background-color: #3b82f6;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#relation_detail_btn_export:hover {
    background-color: #2563eb;
}

QPushButton#relation_detail_btn_export_unmatched {
    background-color: #f59e0b;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton#relation_detail_btn_export_unmatched:hover {
    background-color: #d97706;
}

QPushButton#relation_detail_btn_close {
    background-color: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#relation_detail_btn_close:hover {
    background-color: #e5e7eb;
}

QProgressBar#step3_relation_progress {
    border: 1px solid #d1d5db;
    border-radius: 4px;
    text-align: center;
    background-color: #f3f4f6;
}

QProgressBar#step3_relation_progress::chunk {
    background-color: #3b82f6;
    border-radius: 3px;
}

QTextEdit#step3_insights_text {
    background-color: #fefce8;
    border: 1px solid #fde68a;
    border-radius: 4px;
    padding: 8px;
    font-size: 12px;
}

QListWidget#step3_insights_list {
    background-color: #fefce8;
    border: 1px solid #fde68a;
    border-radius: 4px;
    padding: 4px;
    font-size: 12px;
}

QListWidget#step3_insights_list::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin: 2px 0;
}

QListWidget#step3_insights_list::item:hover {
    background-color: #fef3c7;
}

QListWidget#step3_insights_list::item:selected {
    background-color: #fde68a;
    color: #1f2937;
    color: #713f12;
}

/* Step3 清除数据对话框 */
QDialog#step3_clear_dialog {
    background-color: white;
}

QDialog#step3_clear_dialog QCheckBox {
    spacing: 8px;
}

QDialog#step3_clear_dialog QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #d1d5db;
    border-radius: 4px;
    background-color: white;
}

QDialog#step3_clear_dialog QCheckBox::indicator:checked {
    background-color: #dc2626;
    border-color: #dc2626;
}

QDialog#step3_clear_dialog QCheckBox::indicator:hover {
    border-color: #f87171;
}

/* ========== Step3 测试结果弹窗样式 ========== */

QDialog#step3_test_result_dialog {
    background-color: white;
}

QLabel#step3_result_icon {
    font-size: 36px;
}

QLabel#step3_result_title_success {
    font-size: 18px;
    font-weight: bold;
    color: #15803d;
}

QLabel#step3_result_title_error {
    font-size: 18px;
    font-weight: bold;
    color: #dc2626;
}

QLabel#step3_result_message {
    font-size: 13px;
    color: #4b5563;
}

QLabel#step3_result_detail {
    font-size: 12px;
